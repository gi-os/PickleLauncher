<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No touchscreen required — this is a D-pad + keypad device. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      QUERY_ALL_PACKAGES: needed to enumerate installed apps for the launcher grid.
      On Android 10 this is the only way to get the full app list — the
      &lt;queries&gt; manifest tag (API 30+) doesn't apply here.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"
        xmlns:tools="http://schemas.android.com/tools" />

    <!--
      SET_WALLPAPER: for the customizable background. The stock launcher lets
      you pick a wallpaper from the gallery; we do the same via WallpaperManager.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.PickleLauncher"
        android:supportsRtl="true">

        <!--
          The home activity. CATEGORY_HOME + CATEGORY_DEFAULT makes Android
          offer this as a launcher replacement when the user presses Home.
          launchMode=singleTask so there's only ever one instance — pressing
          Home while already in the launcher just brings it to front.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
